// Copy to secrets.h (git-ignored) and fill in:  cp secrets.h.example secrets.h
#pragma once

#define SECRET_SSID       "YOUR_WIFI_SSID"
#define SECRET_WIFI_PASS  "YOUR_WIFI_PASSWORD"

// web UI basic auth, also the telnet console password: change both
#define SECRET_WEB_USER   "admin"
#define SECRET_WEB_PASS   "change-me"

// OTA upload password: required (the build fails if it is empty). Images must also be
// signed with your key: see scripts/ota-key.sh and scripts/ota.sh
#define SECRET_OTA_PASS   "change-me-too"
