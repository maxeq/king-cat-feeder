#!/usr/bin/env bash
# Blocks a commit that would fail CI, or that adds a file which must never be public.
cd "$(git rev-parse --show-toplevel)"
if git diff --cached --name-only | grep -qE '(^|/)secrets\.h$|demo_photos\.json$|\.(step|stp|kicad_pcb|kicad_sch|gbr)$'; then
  echo "pre-commit: a private file is staged (secrets.h, photos, CAD or PCB). Unstage it." >&2
  exit 1
fi
scripts/check.sh || { echo "pre-commit: checks failed; fix them or commit with --no-verify if you must." >&2; exit 1; }
