#!/usr/bin/env bash
# The project's gate (there is no CI): blocks a commit that fails the checks, or that adds a file
# which must never be public. A commit that touches the firmware also builds it, warnings included.
cd "$(git rev-parse --show-toplevel)"
if git diff --cached --name-only | grep -qE '(^|/)secrets\.h$|demo_photos\.json$|\.(step|stp|kicad_pcb|kicad_sch|gbr)$'; then
  echo "pre-commit: a private file is staged (secrets.h, photos, CAD or PCB). Unstage it." >&2
  exit 1
fi
build=
if git diff --cached --name-only | grep -qE '^firmware/king_board/(src/|king_board\.ino|sketch\.yaml|build_opt\.h|ota_pubkey\.h)'; then
  build=--build
fi
scripts/check.sh $build || { echo "pre-commit: checks failed; fix them or commit with --no-verify if you must." >&2; exit 1; }
